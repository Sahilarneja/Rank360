{
  "crons": [
    {
      "path": "/api/scrape",
      "schedule": "*/30 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/image(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    }
  ],
  "functions": {
    "src/app/api/scrape/route.js": {
      "maxDuration": 60
    },
    "src/app/api/cleanup/route.js": {
      "maxDuration": 60
    }
  }
}
