# ─────────────────────────────────────────────────────────────
# Rank360 – Environment Variables
# Copy this file to .env.local for local dev
# Set ALL of these in Vercel Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database (Neon in production, local Postgres in dev) ──────
# Local:      postgresql://sahilarneja@localhost:5432/rank360
# Production: postgresql://user:pass@ep-xxx.neon.tech/rank360?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_vSpJLO4kluh5@ep-steep-lab-anwlyt4a-pooler.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Site ──────────────────────────────────────────────────────
# Local dev:  http://localhost:3000
# Production: https://rank360.in
NEXT_PUBLIC_SITE_URL=https://rank360.in
NEXT_PUBLIC_SITE_NAME=Rank360

# ── Google Analytics GA4 ──────────────────────────────────────
# Get from: analytics.google.com → Admin → Data Streams → Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google AdSense ────────────────────────────────────────────
# Get from: adsense.google.com → Account → Publisher ID
# Format: ca-pub-XXXXXXXXXXXXXXXXX
# Leave blank until AdSense approves your site
NEXT_PUBLIC_ADSENSE_ID=

# ── ISR Revalidation Secret ───────────────────────────────────
# Any random string — used to trigger on-demand revalidation
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=change-this-to-a-random-secret

# ── Vercel Cron Secret ────────────────────────────────────────
# Protects the /api/scrape endpoint from unauthorized calls
# Generate: openssl rand -hex 32
CRON_SECRET=change-this-to-another-random-secret

# ── Google Search Console ─────────────────────────────────────
# Get from: search.google.com/search-console → Verify → HTML tag
# Paste only the content value, not the full meta tag
NEXT_PUBLIC_GSC_VERIFICATION=your-google-site-verification-code
